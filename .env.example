# AI Platform Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Master Auth
API_KEY_HEADER=Authorization
MASTER_API_KEY=sk-platform-master-key-change-in-production

# Database (PostgreSQL with pgvector for prod; SQLite fallback supported in dev)
# For local Postgres/pgvector via Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_platform
# For standalone local zero-dependency development/testing:
# DATABASE_URL=sqlite+aiosqlite:///./ai_platform.db

# Config Paths
PROVIDERS_CONFIG_PATH=config/providers.yaml
ROUTING_CONFIG_PATH=config/routing.yaml

# Provider API Credentials (Optional - defaults to mock provider if empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

HOSTED_AI_BASE_URL=https://api.openai.com/v1
HOSTED_AI_API_KEY=

# Asterisk PBX WebSocket bridge
PBX_WS_URL=ws://192.168.1.133:9093
PBX_IGNORE_TRANSCRIPT=true
IVR_CHAT_MODEL=mock-chat
IVR_LANGUAGE=auto

# Audio Intelligence (Milestone 1)
AUDIO_INTELLIGENCE_ENABLED=true
VAD_PROVIDER=adaptive
VAD_THRESHOLD=0.42
NOISE_SUPPRESSION_ENABLED=true
NOISE_SUPPRESSION_PROVIDER=spectral
ECHO_CANCELLATION_ENABLED=false


# Direct Live CRM PostgreSQL Database (Universal Data Access)
REMOTE_TOOLS_PREFER_REMOTE=false
CRM_DB_ENABLED=false
CRM_DB_ENGINE=postgresql
CRM_DB_HOST=192.168.1.124
CRM_DB_PORT=5435
CRM_DB_NAME=crm_backend_db
CRM_DB_SCHEMA=public
CRM_DB_USERNAME=postgres
CRM_DB_PASSWORD=
CRM_DB_READ_ONLY=true
